# Backend
DATABASE_URL=sqlite:///./data_core.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated frontend origin(s) allowed to call this API cross-origin.
# Leave empty for local dev (any http://localhost:*/127.0.0.1:* port is
# allowed automatically). Set in deployment, e.g.:
# ALLOWED_ORIGINS=https://ai-business-os.vercel.app
ALLOWED_ORIGINS=
# Optional: Brave Search API key for real web search in supplier sourcing.
# Leave empty to use internal data only (the sourcing run says so).
BRAVE_SEARCH_API_KEY=

# V3 Veilleur agent (web watch, 24h/24). Key from perplexity.ai > API. Empty = the Veilleur searches nothing and says so.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=perplexity/sonar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# V3 sign-in. "required" (default): every API call needs a signed-in user and
# only sees that user's company. "legacy": the V2 demo mode (no sign-in,
# profile switcher, one company) -- never for real customers.
AUTH_MODE=required
# Signs access tokens; required in "required" mode. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# Whether anyone can create a new company from /signup.
SIGNUP_ENABLED=true
# Frontend URL used in invitation links.
FRONTEND_URL=http://localhost:3000

# Frontend: NEXT_PUBLIC_API_URL is NOT read from this file -- Next.js only
# reads frontend/.env*. See frontend/.env.example (copy to frontend/.env.local).
